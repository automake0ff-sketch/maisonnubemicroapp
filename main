import { useMemo, useState } from 'react';
import { createRoot } from 'react-dom/client';
import './styles.css';

type Lang = 'es' | 'en';
type View = 'home' | 'boxes' | 'builder' | 'corporate' | 'admin' | 'confirmation';
type Product = { id:string; name:string; en:string; price:number; category:string; image:string; description:string; available:boolean };
type BoxType = { id:string; name:string; en:string; base:number; description:string };
type Request = { id:string; name:string; email:string; total:number; status:'Nueva'|'En revisión'|'Contactada'|'Cerrada'; type:string; date:string };

const products: Product[] = [
 {id:'croissant',name:'Croissant de mantequilla',en:'Butter croissant',price:3,image:'🥐',category:'Bollería',description:'Pieza artesanal de demostración.',available:true},
 {id:'cookie',name:'Cookie de chocolate',en:'Chocolate cookie',price:3.5,image:'🍪',category:'Dulces',description:'Cookie de demostración.',available:true},
 {id:'brownie',name:'Brownie artesanal',en:'Artisan brownie',price:4,image:'🍫',category:'Dulces',description:'Brownie de demostración.',available:true},
 {id:'cake',name:'Mini tarta de temporada',en:'Seasonal mini cake',price:6,image:'🍰',category:'Pastelería',description:'Selección de temporada de demostración.',available:true},
 {id:'coffee',name:'Bolsa de café de especialidad',en:'Specialty coffee bag',price:12,image:'☕',category:'Café',description:'Café de origen de demostración.',available:true},
 {id:'four',name:'Caja de cuatro dulces',en:'Four sweets box',price:14,image:'🎁',category:'Cajas',description:'Surtido de demostración.',available:true},
 {id:'eight',name:'Caja de ocho dulces',en:'Eight sweets box',price:25,image:'🎀',category:'Cajas',description:'Surtido de demostración.',available:true},
 {id:'card',name:'Tarjeta de dedicatoria',en:'Gift card',price:2,image:'✉️',category:'Extras',description:'Tarjeta personalizable de demostración.',available:true}
];
const boxTypes: BoxType[] = [
 {id:'solo',name:'Caja individual',en:'Solo box',base:0,description:'Un gesto pequeño, muy cuidado.'},
 {id:'two',name:'Caja para dos',en:'Box for two',base:0,description:'Para compartir una pausa deliciosa.'},
 {id:'share',name:'Caja para compartir',en:'Sharing box',base:0,description:'Más detalles, más conversación.'},
 {id:'gift',name:'Caja para regalar',en:'Gift box',base:0,description:'Una celebración envuelta con intención.'},
 {id:'business',name:'Caja para empresas',en:'Business box',base:0,description:'Atenciones que dejan huella.'}
];
const demoRequests: Request[] = [
 {id:'MN-024',name:'Lucía Martín',email:'lucia@ejemplo.demo',total:31,status:'Nueva',type:'Caja para regalar',date:'03 nov'}, {id:'MN-023',name:'Atlas Studio',email:'hola@atlas.demo',total:94,status:'En revisión',type:'Empresas',date:'02 nov'}, {id:'MN-022',name:'Daniel Ruiz',email:'daniel@ejemplo.demo',total:26,status:'Contactada',type:'Caja para dos',date:'01 nov'}, {id:'MN-021',name:'Marta López',email:'marta@ejemplo.demo',total:42,status:'Cerrada',type:'Caja para compartir',date:'30 oct'}, {id:'MN-020',name:'Norte & Co.',email:'equipo@norte.demo',total:120,status:'Nueva',type:'Empresas',date:'29 oct'}, {id:'MN-019',name:'Clara Vega',email:'clara@ejemplo.demo',total:20,status:'Cerrada',type:'Caja individual',date:'27 oct'}
];
const tx = { es:{home:'Inicio',boxes:'Cajas',builder:'Crear mi caja',corporate:'Empresas',admin:'Demo admin',hero:'Regala algo delicioso.',sub:'Diseña una caja gourmet con café de especialidad y pequeños placeres artesanales.',discover:'Descubrir las cajas',start:'Crear mi caja',step:'Paso',next:'Continuar',back:'Volver',total:'Total orientativo',request:'Solicitar este pedido'}, en:{home:'Home',boxes:'Boxes',builder:'Build a box',corporate:'Business',admin:'Demo admin',hero:'Give something delicious.',sub:'Design a gourmet box with specialty coffee and handcrafted little pleasures.',discover:'Discover boxes',start:'Build my box',step:'Step',next:'Continue',back:'Back',total:'Estimated total',request:'Request this order'}};
const euro=(n:number)=>new Intl.NumberFormat('es-ES',{style:'currency',currency:'EUR'}).format(n);

function App(){
 const [view,setView]=useState<View>('home'), [lang,setLang]=useState<Lang>('es'), [step,setStep]=useState(1), [box,setBox]=useState('gift'), [quantities,setQuantities]=useState<Record<string,number>>({}), [occasion,setOccasion]=useState('Simplemente porque sí'), [personal,setPersonal]=useState({recipient:'',note:'',date:'',slot:'Mañana',comments:''}), [sent,setSent]=useState(false), [filter,setFilter]=useState('Todas');
 const t=tx[lang]; const subtotal=products.reduce((sum,p)=>sum+(quantities[p.id]||0)*p.price,0); const hasCard=(quantities.card||0)>0; const total=subtotal;
 const setQty=(id:string,delta:number)=>setQuantities(q=>({...q,[id]:Math.max(0,(q[id]||0)+delta)}));
 const nav=(v:View)=>{setView(v); if(v==='builder')setStep(1); window.scrollTo({top:0,behavior:'smooth'})};
 const selected=products.filter(p=>quantities[p.id]);
 const summary=<aside className="summary"><div className="eyebrow">TU CAJA</div><h3>{boxTypes.find(b=>b.id===box)?.name}</h3>{selected.length ? selected.map(p=><div className="summary-row" key={p.id}><span>{quantities[p.id]} × {p.name}</span><b>{euro(p.price*quantities[p.id])}</b></div>):<p className="muted">Aún no has añadido productos.</p>}<div className="total"><span>{t.total}</span><strong>{euro(total)}</strong></div><p className="fine">Los precios son orientativos en esta demo. El pedido, la disponibilidad y el importe final deberán ser confirmados por el establecimiento.</p></aside>;
 const goRequest=()=>{setStep(6);};
 const submit=(e:React.FormEvent<HTMLFormElement>)=>{e.preventDefault(); const fd=new FormData(e.currentTarget); if(!fd.get('privacy')) return; setSent(true); setView('confirmation');};
 return <><header><button className="logo" onClick={()=>nav('home')} aria-label="Maison Nube inicio">MAISON<br/><i>NUBE</i></button><nav>{(['home','boxes','builder','corporate'] as const).map(v=><button key={v} onClick={()=>nav(v)} className={view===v?'active':''}>{t[v]}</button>)}</nav><div className="header-actions"><button className="lang" onClick={()=>setLang(lang==='es'?'en':'es')}>{lang==='es'?'EN':'ES'}</button><button className="admin-link" onClick={()=>nav('admin')}>{t.admin}</button></div></header>
 <main>
 {view==='home'&&<><section className="hero"><div className="hero-copy"><span className="eyebrow">SEVILLA · PROYECTO DEMO</span><h1>{t.hero}</h1><p>{t.sub}</p><div className="actions"><button className="primary" onClick={()=>nav('builder')}>{t.start} <span>→</span></button><button className="ghost" onClick={()=>nav('boxes')}>{t.discover}</button></div></div><div className="hero-art" role="img" aria-label="Caja gourmet de demostración con café y pastelería"><div className="sun"></div><div className="box-art">MAISON<br/><b>NUBE</b><small>PEQUEÑOS DETALLES<br/>GRANDES MOMENTOS</small></div><span className="coffee">☕</span><span className="pastry">🥐</span></div></section>
 <section className="intro"><span className="eyebrow">EL GESTO IMPORTA</span><h2>Una caja pensada para<br/>hacer una pausa.</h2><p>MAISON NUBE es una marca ficticia creada para demostrar cómo una cafetería puede transformar sus encargos personalizados en una experiencia digital cuidada.</p></section>
 <section className="category-grid">{[['Para regalar','Detalles que se recuerdan.','gift'],['Para compartir','Una mesa, una conversación.','share'],['Para empresas','Atenciones con intención.','business']].map(([a,b,c])=><button className="category" key={a} onClick={()=>{setBox(c);nav('builder')}}><span className="category-mark">✦</span><h3>{a}</h3><p>{b}</p><span>Explorar →</span></button>)}</section>
 <section className="steps-block"><div><span className="eyebrow">MUY SENCILLO</span><h2>Tu caja, a tu manera.</h2></div><ol>{[['01','Elige tu formato'],['02','Combina los sabores'],['03','Envía tu solicitud']].map(x=><li key={x[0]}><b>{x[0]}</b><span>{x[1]}</span></li>)}</ol></section>
 <section className="corporate-cta"><div><span className="eyebrow">REUNIONES & CELEBRACIONES</span><h2>Pequeños placeres<br/>para todo el equipo.</h2><button className="ghost light" onClick={()=>nav('corporate')}>Solicitar presupuesto</button></div><div className="corporate-symbol">✦</div></section></>}
 {view==='boxes'&&<section className="page"><span className="eyebrow">COLECCIÓN DEMO</span><h1>Cajas para cada momento.</h1><p className="lead">Elige un punto de partida y termina la caja a tu gusto.</p><div className="box-grid">{boxTypes.map((b,i)=><article className="box-card" key={b.id}><div className={'box-visual v'+i}>MAISON<br/><b>NUBE</b></div><span className="eyebrow">PERSONALIZABLE</span><h2>{lang==='es'?b.name:b.en}</h2><p>{b.description}</p><button className="text-btn" onClick={()=>{setBox(b.id);nav('builder')}}>Configurar esta caja →</button></article>)}</div><section className="catalog"><span className="eyebrow">CATÁLOGO EDITABLE</span><h2>Pequeños placeres.</h2><ProductGrid products={products} quantities={quantities} setQty={setQty}/></section></section>}
 {view==='builder'&&<section className="builder"><div className="builder-head"><span className="eyebrow">CUSTOM BOX</span><h1>Diseña tu momento.</h1><div className="progress">{[1,2,3,4,5].map(n=><button key={n} className={n===step?'now':n<step?'done':''} onClick={()=>n<step&&setStep(n)} aria-label={`Paso ${n}`}>{n}<span>{['Caja','Sabores','Ocasión','Mensaje','Revisar'][n-1]}</span></button>)}</div></div><div className="builder-layout"><div className="step-content">
 {step===1&&<><h2>Elige tu caja</h2><p>Selecciona el formato que mejor encaje con la ocasión.</p><div className="format-list">{boxTypes.map(b=><button key={b.id} className={box===b.id?'choice selected':'choice'} onClick={()=>setBox(b.id)}><span className="round">{box===b.id?'✓':'○'}</span><span><b>{lang==='es'?b.name:b.en}</b><small>{b.description}</small></span><em>→</em></button>)}</div></>}
 {step===2&&<><h2>Elige tus productos</h2><p>Añade los detalles que harán única tu caja.</p><ProductGrid products={products} quantities={quantities} setQty={setQty}/></>}
 {step===3&&<><h2>¿Cuál es la ocasión?</h2><p>Nos ayuda a entender el tono de tu regalo.</p><div className="occasion-grid">{['Cumpleaños','Aniversario','Regalo de agradecimiento','Desayuno especial','Reunión de trabajo','Celebración familiar','Simplemente porque sí'].map(o=><button className={occasion===o?'occasion selected':'occasion'} onClick={()=>setOccasion(o)} key={o}>{occasion===o&&<span>✓</span>}{o}</button>)}</div></>}
 {step===4&&<><h2>Personaliza tu regalo</h2><p>Todos los detalles se confirmarán contigo antes de preparar el pedido.</p><div className="form-grid"><label>Nombre de la persona destinataria <input value={personal.recipient} onChange={e=>setPersonal({...personal,recipient:e.target.value})} placeholder="Opcional" /></label><label>Fecha preferida <input type="date" value={personal.date} onChange={e=>setPersonal({...personal,date:e.target.value})}/><small>La fecha está pendiente de confirmación.</small></label><label className="wide">Dedicatoria <textarea value={personal.note} onChange={e=>setPersonal({...personal,note:e.target.value})} placeholder="Escribe unas palabras…" /></label><label>Franja horaria <select value={personal.slot} onChange={e=>setPersonal({...personal,slot:e.target.value})}><option>Mañana</option><option>Mediodía</option><option>Tarde</option></select></label><label>Preferencias o comentarios <input value={personal.comments} onChange={e=>setPersonal({...personal,comments:e.target.value})} placeholder="Opcional" /></label></div></>}
 {step===5&&<><h2>Revisa tu caja</h2><p>Comprueba los detalles antes de enviar una solicitud.</p><div className="review-card"><span className="eyebrow">{occasion}</span><h3>{boxTypes.find(b=>b.id===box)?.name}</h3>{selected.length?selected.map(p=><div className="summary-row" key={p.id}><span>{quantities[p.id]} × {p.name}</span><b>{euro(p.price*quantities[p.id])}</b></div>):<p className="error">Añade al menos un producto para continuar.</p>}<hr/><p><b>Fecha solicitada:</b> {personal.date||'Pendiente de indicar'}</p><p><b>Dedicatoria:</b> {personal.note||'Sin dedicatoria'}</p></div></>}
 {step===6&&<RequestForm total={total} onSubmit={submit}/>}</div>{step<6&&summary}</div><div className="builder-nav">{step>1&&<button className="ghost" onClick={()=>setStep(step-1)}>← {t.back}</button>}{step<5?<button className="primary" onClick={()=>setStep(step+1)}>{t.next} →</button>:<button className="primary" disabled={!selected.length} onClick={goRequest}>{t.request} →</button>}</div></section>}
 {view==='corporate'&&<Corporate onDone={()=>{setSent(true);setView('confirmation')}}/>}
 {view==='confirmation'&&<section className="confirmation"><div className="check">✓</div><span className="eyebrow">MODO DEMO</span><h1>Solicitud de demostración completada.</h1><p>No se ha enviado ningún pedido real al establecimiento. En un entorno de producción, el equipo revisaría disponibilidad, importe final y siguientes pasos.</p><button className="primary" onClick={()=>nav('home')}>Volver al inicio</button></section>}
 {view==='admin'&&<Admin requests={demoRequests} filter={filter} setFilter={setFilter}/>} 
 </main><footer><div className="logo">MAISON<br/><i>NUBE</i></div><p>Pequeños detalles. Grandes momentos.</p><span>Proyecto conceptual · Productos y precios ficticios</span></footer></>;
}
function ProductGrid({products,quantities,setQty}:{products:Product[],quantities:Record<string,number>,setQty:(id:string,d:number)=>void}){return <div className="product-grid">{products.map(p=><article className="product" key={p.id}><div className="product-image"><span>{p.image}</span><small>DEMO</small></div><div className="product-info"><span className="eyebrow">{p.category}</span><h3>{p.name}</h3><p>{p.description}</p><div className="product-foot"><b>{euro(p.price)}</b><div className="quantity"><button onClick={()=>setQty(p.id,-1)} disabled={!quantities[p.id]} aria-label={`Quitar ${p.name}`}>−</button><span>{quantities[p.id]||0}</span><button onClick={()=>setQty(p.id,1)} disabled={!p.available} aria-label={`Añadir ${p.name}`}>+</button></div></div><small className="pending">Información pendiente de verificar</small></div></article>)}</div>}
function RequestForm({total,onSubmit}:{total:number,onSubmit:(e:React.FormEvent<HTMLFormElement>)=>void}){return <form onSubmit={onSubmit} className="request-form"><span className="eyebrow">ÚLTIMO PASO</span><h2>¿A dónde enviamos la confirmación?</h2><p>Esta es una solicitud de demostración; no es un pedido real.</p><div className="form-grid"><label>Nombre*<input name="name" required placeholder="Tu nombre"/></label><label>Correo electrónico*<input name="email" required type="email" placeholder="tu@email.com"/></label><label>Teléfono <input name="phone" type="tel" placeholder="Opcional"/></label><label>Tipo de pedido <input value="Caja personalizada" readOnly/></label><label className="wide">Comentarios <textarea name="comments" placeholder="¿Quieres añadir algo más?"/></label></div><div className="request-total">Total orientativo <b>{euro(total)}</b></div><label className="checkbox"><input required name="privacy" type="checkbox"/> Entiendo que esta solicitud es una demostración y consiento el tratamiento simulado de los datos para gestionar la solicitud.*</label><label className="checkbox"><input name="marketing" type="checkbox"/> Me gustaría recibir novedades (opcional, demo).</label><button className="primary" type="submit">Enviar solicitud de demostración →</button></form>}
function Corporate({onDone}:{onDone:()=>void}){return <section className="page corporate-page"><span className="eyebrow">PEDIDOS PARA EMPRESAS</span><h1>Haz que el día de trabajo sepa mejor.</h1><p className="lead">Cuéntanos qué estás preparando. Esta solicitud no confirma un pedido ni una disponibilidad.</p><form onSubmit={e=>{e.preventDefault();onDone()}} className="corp-form"><div className="form-grid"><label>Nombre de empresa*<input required placeholder="Empresa de demostración"/></label><label>Persona de contacto*<input required placeholder="Nombre y apellidos"/></label><label>Correo electrónico*<input required type="email" placeholder="nombre@empresa.com"/></label><label>Número aproximado de cajas*<input required type="number" min="1" placeholder="12"/></label><label>Tipo de evento*<select required><option value="">Selecciona una opción</option><option>Reunión de empresa</option><option>Desayuno corporativo</option><option>Regalo para clientes</option><option>Regalo para empleados</option><option>Evento privado</option></select></label><label>Fecha preferida <input type="date"/></label><label>Presupuesto orientativo por caja <input placeholder="Ej. 25 €"/></label><label>Productos preferidos <input placeholder="Café, dulces…"/></label><label className="wide">Comentarios <textarea placeholder="Cuéntanos un poco más sobre el evento."/></label></div><label className="checkbox"><input required type="checkbox"/> Consiento el uso simulado de estos datos para gestionar esta solicitud de demostración.*</label><button className="primary">Solicitar presupuesto demo →</button></form></section>}
function Admin({requests,filter,setFilter}:{requests:Request[],filter:string,setFilter:(s:string)=>void}){const rows=filter==='Todas'?requests:requests.filter(r=>r.status===filter); const avg=requests.reduce((a,b)=>a+b.total,0)/requests.length; return <section className="admin"><div className="admin-title"><div><span className="eyebrow">ENTORNO LOCAL</span><h1>Panel de demostración</h1></div><div className="demo-badge">Todos los datos son ficticios</div></div><div className="metrics"><div><span>Solicitudes ficticias</span><b>{requests.length}</b></div><div><span>Valor medio orientativo</span><b>{euro(avg)}</b></div><div><span>Categoría destacada</span><b>Regalos</b></div></div><div className="admin-layout"><div className="requests"><div className="table-head"><h2>Solicitudes</h2><select value={filter} onChange={e=>setFilter(e.target.value)}><option>Todas</option><option>Nueva</option><option>En revisión</option><option>Contactada</option><option>Cerrada</option></select></div>{rows.map(r=><article className="request-row" key={r.id}><div><b>{r.name}</b><small>{r.email} · {r.id}</small></div><span>{r.type}</span><span>{r.date}</span><b>{euro(r.total)}</b><em className={'status '+r.status.replace(' ','-')}>{r.status}</em></article>)}</div><aside className="admin-note"><span className="eyebrow">NOTA DE ALCANCE</span><h3>Diseñado para una demo.</h3><p>Este panel usa datos locales ficticios. No incluye acceso seguro, persistencia ni tratamiento de datos reales.</p><h4>Integraciones pendientes</h4><ul><li>Backend y base de datos</li><li>Control de acceso</li><li>Disponibilidad real</li><li>Notificaciones</li></ul></aside></div></section>}
createRoot(document.getElementById('root')!).render(<App/>);
